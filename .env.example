# Copy the Session pooler host from Supabase > Connect (or use the direct host on IPv6).
DB_HOST=
DB_PORT=5432
DB_NAME=postgres
# Session pooler: postgres.<project-ref>; direct connection: postgres.
DB_USER=
DB_PASSWORD=
DB_SSL=true
# Download from Supabase Project Settings > Database > SSL Configuration.
DB_SSL_CA_FILE=./supabase-ca.crt
NODE_ENV=development
PORT=5000
JWT_SECRET=
OTP_SECRET=
CORS_ORIGINS=http://localhost:8081
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
